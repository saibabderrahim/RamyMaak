APP_NAME=RamyMaak
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# Fuseau de la logique métier (H-10) ; le stockage reste en UTC.
BUSINESS_TIMEZONE=Africa/Algiers

# §12 : Argon2id (paramètres OWASP).
HASH_DRIVER=argon2id
ARGON_MEMORY=19456
ARGON_TIME=2
ARGON_THREADS=1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4 LTS (§9.1). En local sans Docker : DB_CONNECTION=sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ramymaak
DB_USERNAME=ramymaak
DB_PASSWORD=

# Sessions en base : nécessaire à « Me déconnecter de tous mes appareils ».
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Domaines de la PWA autorisés à utiliser le cookie de session (Sanctum SPA).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:8090,127.0.0.1,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ne-pas-repondre@ramymaak.local"
MAIL_FROM_NAME="${APP_NAME}"

# Temps réel (Reverb), utilisé à partir des lots 3 à 6.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
