# Configuration de la pile Docker Compose (recette et production).
# Copier en .env, puis compléter les valeurs marquées « À DÉFINIR ».
# Générer APP_KEY : docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show

RAMYMAAK_VERSION=local

APP_NAME=RamyMaak
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Adresse publique (HTTPS) — À DÉFINIR (Q-15).
APP_URL=https://ramymaak.example.dz
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
BUSINESS_TIMEZONE=Africa/Algiers

# Journaux JSON sur la sortie des conteneurs (§14.6).
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ramymaak
DB_USERNAME=ramymaak
# À DÉFINIR
DB_PASSWORD=
# À DÉFINIR
MYSQL_ROOT_PASSWORD=

HASH_DRIVER=argon2id

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Domaine public, sans schéma — À DÉFINIR.
SANCTUM_STATEFUL_DOMAINS=ramymaak.example.dz

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Serveur SMTP du groupe — À DÉFINIR (notifications e-mail en option).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=ne-pas-repondre@ramymaak.example.dz
MAIL_FROM_NAME=RamyMaak

# Temps réel (§9.6). Les identifiants sont libres ; les générer une fois.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ramymaak
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
